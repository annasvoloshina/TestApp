@page
@model IndexModel
@{
    ViewData["Title"] = "Products";
}

<h1>Products</h1>
<p>Showing @Model.Products.Count row(s) read from PostgreSQL via Entity Framework Core.</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Description</th>
            <th>Price</th>
            <th>Created At (UTC)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model.Products)
        {
            <tr>
                <td>@product.Id</td>
                <td>@product.Name</td>
                <td>@product.Description</td>
                <td>@product.Price.ToString("C")</td>
                <td>@product.CreatedAt.ToString("u")</td>
            </tr>
        }
    </tbody>
</table>
